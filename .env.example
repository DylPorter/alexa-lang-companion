# Sala — example runtime config (copy to .env, which is gitignored)
# Every value below is a NAME + the shape it expects. No real secrets live here.

# ------------------------------------------------------------ backend selection
# echo | proxy | bedrock | openai | gemini. An explicit value wins over
# auto-detection, and an UNRECOGNISED value is a startup error (it used to fall
# through to echo, which answers in canned English and looks like a working demo).
# Auto-detection order: AWS creds -> bedrock, ANTHROPIC_BASE_URL -> proxy,
# GEMINI_API_KEY/GOOGLE_API_KEY -> gemini, OPENAI_API_KEY -> openai, else echo.
# Leave this line commented out to let auto-detection choose — that is the shape of
# a teammate run: paste one key below and start.
SALA_LLM=proxy

# ------------------------------------------------------------ proxy backend
# Anthropic-compatible base URL WITHOUT a trailing slash. The client appends
# /v1/messages. Never commit the real value.
ANTHROPIC_BASE_URL=https://your-gateway.example.com/apps/anthropic
# First non-empty of ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN is used; when both
# hold the same value both x-api-key and Authorization: Bearer are sent.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# Model id for the proxy backend. Fallback order per phase:
#   review -> SALA_REVIEW_MODEL || SALA_MODEL || ANTHROPIC_MODEL || qwen3.8-flash
#   chat   -> SALA_CHAT_MODEL    || SALA_MODEL || ANTHROPIC_MODEL || qwen3.8-flash
# The two phase overrides exist because the end-of-session review is a
# deterministic JSON extraction (a faster/shorter answer is fine there) while the
# persona chat is the thing on camera. Measured numbers: docs/LATENCY.md.
SALA_MODEL=qwen3.8-flash
# SALA_REVIEW_MODEL=            # e.g. a smaller instruct model for the review pass
# SALA_CHAT_MODEL=              # e.g. keep the persona on the better model

# Reasoning control per phase: on | off | default. Shipped default = review OFF,
# chat UNSET (sends no thinking field, so the gateway's own default applies).
# The review is a deterministic JSON extraction and this gateway bills the
# `thinking` block against max_tokens — turning it off is what took the pass from
# a 47.9 s median to 6.3-7.9 s. `default` means the GATEWAY default (reasoning on
# here), not Sala's shipped default. Only the Anthropic `thinking` field is honoured:
# enable_thinking / chat_template_kwargs come back HTTP 200 and are ignored.
# Set SALA_REVIEW_THINKING=on to A/B extraction depth; SALA_CHAT_THINKING=off for a
# measured 0.8 s persona turn — thinner replies, so decide it before you record.
# SALA_REVIEW_THINKING=off
# SALA_CHAT_THINKING=off

# ------------------------------------------------------------ bedrock backend
BEDROCK_MODEL=amazon.nova-lite-v1:0
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or AWS_BEARER_TOKEN_BEDROCK.
# Never logged, never printed.

# ---------------------------------------------------- openai backend (your own key)
# Any OpenAI-compatible /chat/completions server. One key, no AWS, no gateway.
# Never logged, never in the URL — it rides in an Authorization: Bearer header.
OPENAI_API_KEY=
# Optional: point at a compatible server instead of api.openai.com
# (OpenRouter, Groq, LM Studio, Ollama). For a local server that ignores auth, any
# non-empty OPENAI_API_KEY value works, e.g. OPENAI_API_KEY=local.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# Model id for this backend. Checked against your own key at GET {base}/models —
# that list is the only truth about which ids YOUR key can call.
# OPENAI_MODEL=gpt-4o-mini
# The output-budget field and temperature are chosen FROM THE MODEL ID, not a flag:
# o-series and gpt-5+ get max_completion_tokens and no temperature (OpenAI's own
# spec deprecates max_tokens as "not compatible with o-series models"); everything
# else gets max_tokens. On a reasoning id the review pass inherits the model's
# default reasoning effort, so point SALA_REVIEW_MODEL at a non-reasoning id if the
# end-of-session panel feels slow.

# ----------------------------------------------------- gemini backend (your own key)
# Google's Gemini API (generativelanguage.googleapis.com, v1beta :generateContent).
# Docs allow either name; when both are set GOOGLE_API_KEY wins, same as Google's
# own client libraries. Free key: aistudio.google.com. Never logged, never in a URL.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.8-flash
# No thinking/reasoning field is sent here: Gemini 3+ rejects the 2.x budget field
# and 2.x rejects the level field, so "send neither" is the only shape that works
# across ids. Google documents thinking as dynamic by default, sized to the request.

# ------------------------------------------------------------ server + sim
PORT=3000
SIM_PORT=5173
SALA_DB_PATH=./data/sala.db          # gitignored; the user's own file
SALA_TARGET_LANG=en
SALA_NATIVE_LANG=en
SALA_ALLOWED_ORIGINS=http://localhost:5173
